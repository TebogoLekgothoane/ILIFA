# Server-side Gemini key. Never expose this to the Expo client.
GEMINI_API_KEY=

# API listen port. Defaults to 5000 if omitted.
PORT=5000

# Optional model overrides. Defaults are current Gemini 3.8 models.
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Charon
# GEMINI_LIVE_MODEL=gemini-3.8-live
